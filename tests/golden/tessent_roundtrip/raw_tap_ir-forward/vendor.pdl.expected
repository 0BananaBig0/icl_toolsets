iProcsForModule RawIrTop

iProc oracle {} {

   iReset
   iScan -ir jtag -chain default 4 -si 0b0011 -so 0bXX01
   iApply

   iWrite core.r[7:0] 0b10100101
   iRead  core.r[7:0] 0b00000000
   iApply

   iScan -ir jtag -chain default 4 -si 0b0100 -so 0bXX01
   iApply

   iWrite tap.INSTRUCTION[3:0] 0b0011
   iRead  tap.INSTRUCTION[3:0] 0b0001
   iApply

   iWrite core.r[7:0] 0b10100101
   iRead  core.r[7:0] 0b10100101
   iApply


}
