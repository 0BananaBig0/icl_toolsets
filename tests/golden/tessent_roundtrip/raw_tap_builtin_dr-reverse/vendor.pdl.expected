iProcsForModule BuiltinDrTop

iProc oracle {} {

   iReset
   iScan jtag -chain default 32 -si 0b10001001101010111100110111101111 -so 0b00010000000000000000000000000011
   iApply

   iWrite tap.INSTRUCTION[3:0] 0b1111
   iRead  tap.INSTRUCTION[3:0] 0b0001
   iApply

   iScan jtag -chain default 1 -si 0b1 -so 0b0
   iApply

   iScan jtag -chain default 1 -si 0b0 -so 0b0
   iApply


}
