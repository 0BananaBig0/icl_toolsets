iProcsForModule Chains

iProc oracle {} {

   iReset
   iWrite c1.value[3:0] 0b0110
   iRead  c1.value[3:0] 0b0000
   iApply

   iWrite c0.value[3:0] 0b1001
   iRead  c0.value[3:0] 0b0000
   iApply

   iWrite c1.value[3:0] 0b0110
   iRead  c1.value[3:0] 0b0110
   iApply

   iWrite c0.value[3:0] 0b1001
   iRead  c0.value[3:0] 0b1001
   iApply


}
