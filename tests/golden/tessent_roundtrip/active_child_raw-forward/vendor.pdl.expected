iProcsForModule Top

iProc oracle {} {

   iReset
   iScan client -chain default 1 -si 0b1 -so 0bX
   iApply

   iNote -comment "modeled raw history omitted iScan client 9 -si 0b101001011 -so 0b00000000x"
   iScan client -chain default 9 -si 0b101001011 -so 0b00000000X
   iApply

   iNote -comment "modeled dynamic child raw history client child.local 0b00000000"
   iWrite child.value[7:0] 0b10100101
   iRead  child.value[7:0] 0b10100101
   iWrite open 0b1
   iRead  open 0b1
   iApply


}
