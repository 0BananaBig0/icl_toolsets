iProcsForModule PortControlTop

iProc oracle {} {

   iReset
   iWrite tap.INSTRUCTION[3:0] 0b0100
   iRead  tap.INSTRUCTION[3:0] 0b0001
   iApply

   iWrite core.a[3:0] 0b0101
   iRead  core.a[3:0] 0b0000
   iWrite core.b[3:0] 0b1010
   iRead  core.b[3:0] 0b0000
   iApply

   iWrite core.a[3:0] 0b0110
   iRead  core.a[3:0] 0b0101
   iWrite core.b[3:0] 0b1011
   iRead  core.b[3:0] 0b1010
   iApply


}
