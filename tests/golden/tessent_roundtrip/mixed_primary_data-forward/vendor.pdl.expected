iProcsForModule MixedPrimaryDataProbe

iProc oracle {} {

   iReset
   iWrite tap.INSTRUCTION[3:0] 0b0011
   iRead  tap.INSTRUCTION[3:0] 0b0001
   iApply

   iWrite data[3] 0b0
   iWrite data[2] 0b1
   iWrite data[1] 0b0
   iWrite data[0] 0b1
   iApply

   iWrite core.enable 0b1
   iApply

   iRead observed[3] 0b0
   iRead observed[2] 0b1
   iRead observed[1] 0b0
   iRead observed[0] 0b1
   iApply

   iWrite data[3] 0b1
   iWrite data[2] 0b0
   iWrite data[1] 0b0
   iWrite data[0] 0b1
   iApply

   iWrite core.enable 0b1
   iApply


}
