iProcsForModule PortControlTop

iProc oracle {} {

   iReset
   iWrite tap.INSTRUCTION[3:0] 0b0011
   iRead  tap.INSTRUCTION[3:0] 0b0001
   iApply

   iWrite core.a[3:0] 0b1001
   iWrite core.b[3:0] 0b0000
   iApply

   iWrite core.a[3:0] 0b1001
   iRead  core.a[3:0] 0b1001
   iWrite core.b[3:0] 0b0000
   iApply

   iWrite core.a[3:0] 0b1100
   iWrite core.b[3:0] 0b0000
   iApply


}
