iProcsForModule PortControlTop

iProc oracle {} {

   iReset
   iWrite tap.INSTRUCTION[3:0] 0b0100
   iRead  tap.INSTRUCTION[3:0] 0b0001
   iApply

   iWrite core.a[3:0] 0b0000
   iWrite core.b[3:0] 0b0000
   iApply

   iWrite core.a[3:0] 0b0001
   iWrite core.b[3:0] 0b0000
   iApply

   iWrite core.a[3:0] 0b0010
   iWrite core.b[3:0] 0b0000
   iApply


}
