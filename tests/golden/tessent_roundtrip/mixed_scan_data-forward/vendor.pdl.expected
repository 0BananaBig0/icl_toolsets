iProcsForModule MixedScanDataProbe

iProc oracle {} {

   iReset
   iWrite enable 0b1
   iApply

   iWrite tap.INSTRUCTION[3:0] 0b0011
   iRead  tap.INSTRUCTION[3:0] 0b0001
   iApply

   iWrite core.data[3:0] 0b0101
   iApply

   iRead observed[3] 0b0
   iRead observed[2] 0b1
   iRead observed[1] 0b0
   iRead observed[0] 0b1
   iApply

   iWrite core.data[3:0] 0b1001
   iApply


}
