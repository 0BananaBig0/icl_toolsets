iProcsForModule RawDrTop

iProc oracle {} {

   iReset
   iWrite tap.INSTRUCTION[3:0] 0b0011
   iRead  tap.INSTRUCTION[3:0] 0b0001
   iApply

   iScan jtag -chain default 8 -si 0b10010110 -so 0b00000000
   iApply

   iWrite core.r[7:0] 0b10010110
   iRead  core.r[7:0] 0b10010110
   iApply

   iScan -ir jtag -chain default 4 -si 0b0100 -so 0b0001
   iApply

   iScan -ir jtag -chain default 4 -si 0b0011 -so 0b0001
   iApply

   iScan jtag -chain default 8 -si 0b00111100 -so 0b10010110
   iApply


}
