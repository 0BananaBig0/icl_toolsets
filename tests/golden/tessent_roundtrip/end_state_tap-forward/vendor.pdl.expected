iProcsForModule EndStateAccessTop

iProc oracle {} {

   iReset
   iWrite tap.INSTRUCTION[3:0] 0b0011
   iRead  tap.INSTRUCTION[3:0] 0b0001
   iApply

   iWrite core.gate[1:0] 0b01
   iApply

   iWrite core.gate[1:0] 0b00
   iWrite core.leaf.value[7:0] 0b10010110
   iApply

   iWrite core.gate[1:0] 0b01
   iApply

   iWrite core.gate[1:0] 0b00
   iWrite core.leaf.value[7:0] 0b10010110
   iApply


}
