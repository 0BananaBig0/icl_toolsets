iProcsForModule chip_top

iProc chip_top {} {

   iReset
   iNote "Activate selection of the following scan muxes:"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.DRMux, selection 0: instruction = 4'b1111 -> DRMux = bypass"
   iNote "Scan in verification pattern to the following scan register:"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.bypass, load value = 1"
   iWrite chip_top_rtl1_tessent_tap_main_inst.bypass 0b1
   iRead  chip_top_rtl1_tessent_tap_main_inst.bypass 0b0
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan register:"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.bypass, expected value = 1"
   iWrite chip_top_rtl1_tessent_tap_main_inst.bypass 0b0
   iRead  chip_top_rtl1_tessent_tap_main_inst.bypass 0b1
   iApply

