   iWrite piccpu_rtl2_tessent_lbist_inst.bist_sync_reset 0b0
   iRead  piccpu_rtl2_tessent_lbist_inst.bist_sync_reset 0b0
   iWrite piccpu_rtl2_tessent_lbist_inst.bist_clock_disable 0b0
   iRead  piccpu_rtl2_tessent_lbist_inst.bist_clock_disable 0b0
   iWrite piccpu_rtl2_tessent_lbist_inst.bist_setup[2:0] 0b000
   iRead  piccpu_rtl2_tessent_lbist_inst.bist_setup[2:0] 0b000
   iWrite piccpu_rtl2_tessent_lbist_inst.bist_en 0b1
   iWrite piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_sib_control_registers_i.sib 0b1
   iRead  piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_sib_control_registers_i.sib 0b0
   iWrite piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_edt_sib_i.sib 0b0
   iRead  piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_edt_sib_i.sib 0b0
   iWrite piccpu_rtl2_tessent_lbist_inst.ijtag_so_ff 0b0
   iRead  piccpu_rtl2_tessent_lbist_inst.ijtag_so_ff 0b0
   iWrite piccpu_rtl2_tessent_sib_lbist_inst.sib 0b1
   iRead  piccpu_rtl2_tessent_sib_lbist_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_occ_clk_inst.tdr[9:0] 0b0000010001
   iRead  piccpu_rtl2_tessent_occ_clk_inst.tdr[9:0] 0b0000000000
   iWrite piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib 0b1
   iRead  piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib 0b0
   iWrite piccpu_rtl2_tessent_occ_ramclk_inst.tdr[9:0] 0b0000010001
   iRead  piccpu_rtl2_tessent_occ_ramclk_inst.tdr[9:0] 0b0000000000
   iWrite piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib 0b1
   iRead  piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_occ_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_occ_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0101111111
   iRead  piccpu_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0000000000
   iWrite piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   #  Unlock iWrite targets with explicit_iwrite_only attribute:
   iWrite piccpu_rtl1_tessent_sib_sti_inst.ltest_en 0b1
   iWrite piccpu_rtl1_tessent_sib_sti_inst.ltest_occ_en 0b1

   iApply

   iNote "Setting up controller piccpu_rtl2_tessent_lbist_inst"
   iNote "    Number of patterns  : 211 (211 + 0 warm-up patterns)"
   iNote "    Pattern Length      : 38"
   iNote "    Shift Clk Select    : 0b00"
   iNote "    Capture Phase Width : 0x7 Shift Clock Cycles"
   iNote "    PRPG Seed : 0x13e909bd"
   iNote "    MISR Seed : 0x000000"
