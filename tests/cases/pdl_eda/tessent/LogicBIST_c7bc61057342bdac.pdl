iProcsForModule piccpu

iTopProc serial_load_initial_settings {} {

   iForcePort [list "reset"] 0b0
   iForcePort [list "scan_en"] 0b0 -not_persistent
   iApply

   iReset

}


iProcsForModule piccpu

iTopProc serial_load {} {

   iForcePort [list "reset"] 0b0
   iForcePort [list "scan_en"] 0b0 -not_persistent
   iApply

   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b0
   iApply

   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iRead  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iWrite piccpu_rtl2_tessent_sib_lbist_inst.sib 0b1
   iRead  piccpu_rtl2_tessent_sib_lbist_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_occ_inst.sib 0b1
   iRead  piccpu_rtl2_tessent_sib_occ_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply

   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iRead  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iWrite piccpu_rtl2_tessent_single_chain_mode_logic_inst.tdr_sib_i.sib 0b0
   iRead  piccpu_rtl2_tessent_single_chain_mode_logic_inst.tdr_sib_i.sib 0b0
   iWrite piccpu_rtl2_tessent_single_chain_mode_logic_inst.single_chain_sib_i.sib 0b0
   iRead  piccpu_rtl2_tessent_single_chain_mode_logic_inst.single_chain_sib_i.sib 0b0
   iWrite piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_sib_bist_registers_i.sib 0b0
   iRead  piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_sib_bist_registers_i.sib 0b0
   iWrite piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_sib_ncp_limits_sib_i.sib 0b0
   iRead  piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_sib_ncp_limits_sib_i.sib 0b0
   iWrite piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_sib_control_registers_i.sib 0b1
   iRead  piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_sib_control_registers_i.sib 0b0
   iWrite piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_edt_sib_i.sib 0b0
   iRead  piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_edt_sib_i.sib 0b0
   iWrite piccpu_rtl2_tessent_lbist_inst.ijtag_so_ff 0b0
   iRead  piccpu_rtl2_tessent_lbist_inst.ijtag_so_ff 0b0
   iWrite piccpu_rtl2_tessent_sib_lbist_inst.sib 0b1
   iRead  piccpu_rtl2_tessent_sib_lbist_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib 0b1
   iRead  piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib 0b0
   iWrite piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib 0b1
   iRead  piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_occ_inst.sib 0b1
   iRead  piccpu_rtl2_tessent_sib_occ_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iRead  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply

   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b10
   iRead  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iWrite piccpu_rtl2_tessent_single_chain_mode_logic_inst.tdr_sib_i.sib 0b0
   iRead  piccpu_rtl2_tessent_single_chain_mode_logic_inst.tdr_sib_i.sib 0b0
   iWrite piccpu_rtl2_tessent_single_chain_mode_logic_inst.single_chain_sib_i.sib 0b0
   iRead  piccpu_rtl2_tessent_single_chain_mode_logic_inst.single_chain_sib_i.sib 0b0
   iWrite piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_sib_bist_registers_i.sib 0b0
   iRead  piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_sib_bist_registers_i.sib 0b0
   iWrite piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_sib_ncp_limits_sib_i.sib 0b0
   iRead  piccpu_rtl2_tessent_lbist_inst.piccpu_rtl2_tessent_lbist_sib_ncp_limits_sib_i.sib 0b0
