   iNote "          cell: 30"
   iNote "          cell: 28"
   iNote "          cell: 26"
   iNote "          cell: 24"
   iNote "          cell: 5"
   iNote "          cell: 3"
   iNote "          cell: 1"
   iNote " "
   iNote "  * Setting input Pins with an EVEN pattern:"
   iNote "    Setting  TA_CCI2B  to '1'"
   iNote "    Setting  TA_CCI2A  to '0'"
   iNote "    Setting  TA_CCI1B  to '1'"
   iNote "    Setting  TA_CCI1A  to '0'"
   iNote "    Setting  TA_CCI0B  to '1'"
   iNote "    Setting  TA_CCI0A  to '0'"
   iNote "    Setting  TACLK  to '1'"
   iNote "    Setting  SIGN2  to '0'"
   iNote "    Setting  SIGN1  to '1'"
   iNote "    Setting  RESET_N  to '0'"
   iNote "    Setting  REF_CLK  to '1'"
   iNote "    Setting  MAG2  to '0'"
   iNote "    Setting  MAG1  to '1'"
   iNote "    Setting  LFXT_CLK  to '0'"
   iNote "    Setting  INCLK  to '1'"
   iNote " "
   iNote "  * Loading TAP Instruction Register with PRELOAD instruction."
   iForcePort [list "INCLK" "MAG1" "REF_CLK" "SIGN1" "TACLK" "TA_CCI0B" "TA_CCI1B" "TA_CCI2B"] 0b11111111 -not_persistent
   iScan -ir tap -chain default 4 -si 0b0110 -so 0b0001
   iApply

   iNote " "
   iNote "  * Loading bscan chain with an EVEN pattern:"
   iNote "        EVEN pins = 1  and  ODD pins = 0"
   iScan tap -chain default 90 -si 0b110111011101110111011101110111011101110111011101110111011101110111010101010101010101101110 -so 0bXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX -skip_model_state_simulation
   iApply

   iNote " "
   iNote "  * Loading TAP Instruction Register with EXTEST instruction."
   iScan -ir tap -chain default 4 -si 0b0010 -so 0b0001
   iApply

   iNote "  * Comparing enabled Output Pins with an EVEN pattern:"
   iNote "    Open-drain/source pins are compared only if enabled"
   iRunLoop 1 -tck
   iNote "    Checking  TA_OUT2  with '0'"
   iNote "    Checking  TA_OUT1  with '1'"
   iNote "    Checking  TA_OUT0  with '0'"
   iNote "    Checking  SAMPLE_CLK2  with '0'"
   iNote "    Checking  SAMPLE_CLK1  with '1'"
   iNote "    Checking  GPIO4_7  with '0'"
   iNote "    Checking  GPIO4_6  with '1'"
   iNote "    Checking  GPIO4_5  with '0'"
   iNote "    Checking  GPIO4_4  with '1'"
   iNote "    Checking  GPIO4_3  with '0'"
   iNote "    Checking  GPIO4_2  with '1'"
   iNote "    Checking  GPIO4_1  with '0'"
   iNote "    Checking  GPIO4_0  with '1'"
   iNote "    Checking  GPIO3_7  with '0'"
   iNote "    Checking  GPIO3_6  with '1'"
   iNote "    Checking  GPIO3_5  with '0'"
   iNote "    Checking  GPIO3_4  with '1'"
   iNote "    Checking  GPIO3_3  with '0'"
   iNote "    Checking  GPIO3_2  with '1'"
   iNote "    Checking  GPIO3_1  with '0'"
   iNote "    Checking  GPIO3_0  with '1'"
   iNote "    Checking  GPIO2_7  with '0'"
   iNote "    Checking  GPIO2_6  with '1'"
   iNote "    Checking  GPIO2_5  with '0'"
   iNote "    Checking  GPIO2_4  with '1'"
   iNote "    Checking  GPIO2_3  with '0'"
   iNote "    Checking  GPIO2_2  with '1'"
   iNote "    Checking  GPIO2_1  with '0'"
   iNote "    Checking  GPIO2_0  with '1'"
   iNote "    Checking  GPIO1_7  with '0'"
   iNote "    Checking  GPIO1_6  with '1'"
   iNote "    Checking  GPIO1_5  with '0'"
   iNote "    Checking  GPIO1_4  with '1'"
   iNote "    Checking  GPIO1_3  with '0'"
   iNote "    Checking  GPIO1_2  with '1'"
   iNote "    Checking  GPIO1_1  with '0'"
   iNote "    Checking  GPIO1_0  with '1'"
   iNote "    Checking  ACCUM2  with '0'"
   iNote "    Checking  ACCUM1  with '1'"
   iComparePort [list "GPIO3_0" "GPIO3_1" "GPIO4_0" "GPIO4_1" "ACCUM1" "ACCUM2" "GPIO1_0" "GPIO1_1" "GPIO1_2" "GPIO1_3" "GPIO1_4" "GPIO1_5" "GPIO1_6" "GPIO1_7" "GPIO2_0" "GPIO2_1" "GPIO2_2" "GPIO2_3" "GPIO2_4" "GPIO2_5" "GPIO2_6" "GPIO2_7" "GPIO3_2" "GPIO3_3" "GPIO3_4" "GPIO3_5" "GPIO3_6" "GPIO3_7" "GPIO4_2" "GPIO4_3" "GPIO4_4" "GPIO4_5" "GPIO4_6" "GPIO4_7" "SAMPLE_CLK1" "SAMPLE_CLK2" "TA_OUT0" "TA_OUT1" "TA_OUT2"] 0b101010101010101010101010101010101010010
   iRunLoop 1 -tck
   iComparePort [list "GPIO3_0" "GPIO3_1" "GPIO4_0" "GPIO4_1" "ACCUM1" "ACCUM2" "GPIO1_0" "GPIO1_1" "GPIO1_2" "GPIO1_3" "GPIO1_4" "GPIO1_5" "GPIO1_6" "GPIO1_7" "GPIO2_0" "GPIO2_1" "GPIO2_2" "GPIO2_3" "GPIO2_4" "GPIO2_5" "GPIO2_6" "GPIO2_7" "GPIO3_2" "GPIO3_3" "GPIO3_4" "GPIO3_5" "GPIO3_6" "GPIO3_7" "GPIO4_2" "GPIO4_3" "GPIO4_4" "GPIO4_5" "GPIO4_6" "GPIO4_7" "SAMPLE_CLK1" "SAMPLE_CLK2" "TA_OUT0" "TA_OUT1" "TA_OUT2"] 0bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
   iRunLoop 1 -tck
   iNote " "
   iNote "  * Loading TAP Instruction Register with CLAMP instruction."
   iScan -ir tap -chain default 4 -si 0b0001 -so 0b0001
   iApply

   iNote "  * Shifting a logic 1 into  the  BYPASS register,"
   iNote "    while expecting a logic 0 over the TDO port."
   iNote " "
   iScan tap -chain default 1 -si 0b1 -so 0b0
   iApply

   iNote "  * Re-Comparing enabled Output Pins"
   iNote "    Checking  TA_OUT2  with '0'"
   iNote "    Checking  TA_OUT1  with '1'"
