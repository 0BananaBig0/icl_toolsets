iProcsForModule chip_top

iTopProc JtagBscanTestStep__highz_mode {} {

   iForcePort [list "INCLK" "LFXT_CLK" "MAG1" "MAG2" "REF_CLK" "RESET_N" "SIGN1" "SIGN2" "TACLK" "TA_CCI0A" "TA_CCI0B" "TA_CCI1A" "TA_CCI1B" "TA_CCI2A" "TA_CCI2B"] 0b000000000000000 -not_persistent
   iApply

   iNote " "
   iNote "****************************************************************"
   iNote "  highz_mode test"
   iNote "****************************************************************"
   iNote " "
   iNote " "
   iNote "  * Loading TAP Instruction Register with PRELOAD instruction."
   iScan -ir tap -chain default 4 -si 0b0110 -so 0b0001
   iApply

   iNote "  1- Load all CONTROL and assym drivers cells with their ENABLING value"
   iNote "  2- Use the HIGHZ TAP instruction to disable all pins"
   iNote "  3- Compare all disabled output pins with 'Z'"
   iNote " "
   iNote "  * Loading all control bscan cells with enabling values"
   iNote "    Data registers are all zero"
   iNote " "
   iScan tap -chain default 90 -si 0b100101010101010101010101010101010101010101010101010101010101010101000000000000000000101010 -so 0bXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX -skip_model_state_simulation
   iApply

   iNote " "
   iNote "  * Loading TAP Instruction Register with HIGHZ instruction."
   iScan -ir tap -chain default 4 -si 0b0111 -so 0b0001
   iApply

   iRunLoop 1 -tck
   iNote "  * Comparing all JTAG output pins to 'Z'"
   iNote " "
   iNote "    Checking  TA_OUT2  with 'Z'"
   iNote "    Checking  TA_OUT1  with 'Z'"
   iNote "    Checking  TA_OUT0  with 'Z'"
   iNote "    Checking  SAMPLE_CLK2  with 'Z'"
   iNote "    Checking  SAMPLE_CLK1  with 'Z'"
   iNote "    Checking  GPIO4_7  with 'Z'"
   iNote "    Checking  GPIO4_6  with 'Z'"
   iNote "    Checking  GPIO4_5  with 'Z'"
   iNote "    Checking  GPIO4_4  with 'Z'"
   iNote "    Checking  GPIO4_3  with 'Z'"
   iNote "    Checking  GPIO4_2  with 'Z'"
   iNote "    Checking  GPIO4_1  with 'Z'"
   iNote "    Checking  GPIO4_0  with 'Z'"
   iNote "    Checking  GPIO3_7  with 'Z'"
   iNote "    Checking  GPIO3_6  with 'Z'"
   iNote "    Checking  GPIO3_5  with 'Z'"
   iNote "    Checking  GPIO3_4  with 'Z'"
   iNote "    Checking  GPIO3_3  with 'Z'"
   iNote "    Checking  GPIO3_2  with 'Z'"
   iNote "    Checking  GPIO3_1  with 'Z'"
   iNote "    Checking  GPIO3_0  with 'Z'"
   iNote "    Checking  GPIO2_7  with 'Z'"
   iNote "    Checking  GPIO2_6  with 'Z'"
   iNote "    Checking  GPIO2_5  with 'Z'"
   iNote "    Checking  GPIO2_4  with 'Z'"
   iNote "    Checking  GPIO2_3  with 'Z'"
   iNote "    Checking  GPIO2_2  with 'Z'"
   iNote "    Checking  GPIO2_1  with 'Z'"
   iNote "    Checking  GPIO2_0  with 'Z'"
   iNote "    Checking  GPIO1_7  with 'Z'"
   iNote "    Checking  GPIO1_6  with 'Z'"
   iNote "    Checking  GPIO1_5  with 'Z'"
   iNote "    Checking  GPIO1_4  with 'Z'"
   iNote "    Checking  GPIO1_3  with 'Z'"
   iNote "    Checking  GPIO1_2  with 'Z'"
   iNote "    Checking  GPIO1_1  with 'Z'"
   iNote "    Checking  GPIO1_0  with 'Z'"
   iNote "    Checking  ACCUM2  with 'Z'"
   iNote "    Checking  ACCUM1  with 'Z'"
   iComparePort [list "GPIO3_0" "GPIO3_1" "GPIO4_0" "GPIO4_1" "ACCUM1" "ACCUM2" "GPIO1_0" "GPIO1_1" "GPIO1_2" "GPIO1_3" "GPIO1_4" "GPIO1_5" "GPIO1_6" "GPIO1_7" "GPIO2_0" "GPIO2_1" "GPIO2_2" "GPIO2_3" "GPIO2_4" "GPIO2_5" "GPIO2_6" "GPIO2_7" "GPIO3_2" "GPIO3_3" "GPIO3_4" "GPIO3_5" "GPIO3_6" "GPIO3_7" "GPIO4_2" "GPIO4_3" "GPIO4_4" "GPIO4_5" "GPIO4_6" "GPIO4_7" "SAMPLE_CLK1" "SAMPLE_CLK2" "TA_OUT0" "TA_OUT1" "TA_OUT2"] 0bzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz
   iRunLoop 1 -tck
   iComparePort [list "GPIO3_0" "GPIO3_1" "GPIO4_0" "GPIO4_1" "ACCUM1" "ACCUM2" "GPIO1_0" "GPIO1_1" "GPIO1_2" "GPIO1_3" "GPIO1_4" "GPIO1_5" "GPIO1_6" "GPIO1_7" "GPIO2_0" "GPIO2_1" "GPIO2_2" "GPIO2_3" "GPIO2_4" "GPIO2_5" "GPIO2_6" "GPIO2_7" "GPIO3_2" "GPIO3_3" "GPIO3_4" "GPIO3_5" "GPIO3_6" "GPIO3_7" "GPIO4_2" "GPIO4_3" "GPIO4_4" "GPIO4_5" "GPIO4_6" "GPIO4_7" "SAMPLE_CLK1" "SAMPLE_CLK2" "TA_OUT0" "TA_OUT1" "TA_OUT2"] 0bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
   iRunLoop 1 -tck
   iNote " "
   iNote "  * Comparing TDO output pin to 'Z' in RTI state"
   iComparePort [list "TDO"] 0bz
   iRunLoop 1 -tck
   iComparePort [list "TDO"] 0bx
   iRunLoop 1 -tck
   iNote " "
   iNote "End of the highz_mode test"
   iNote " "

}


iProcsForModule chip_top

iTopProc JtagBscanTestStep__clamp {} {

   iForcePort [list "INCLK" "LFXT_CLK" "MAG1" "MAG2" "REF_CLK" "RESET_N" "SIGN1" "SIGN2" "TACLK" "TA_CCI0A" "TA_CCI0B" "TA_CCI1A" "TA_CCI1B" "TA_CCI2A" "TA_CCI2B"] 0b000000000000000 -not_persistent
   iApply

   iNote " "
   iNote "****************************************************************"
   iNote "  clamp test"
   iNote "****************************************************************"
   iNote " "
   iNote "  * clamp test for enable group Engroup0,"
   iNote "    which includes the following control cells:"
   iNote "          cell: 89"
   iNote "          cell: 86"
   iNote "          cell: 84"
   iNote "          cell: 82"
   iNote "          cell: 80"
   iNote "          cell: 78"
