iProcsForModule cpu_top

iTopProc go_nogo_initial_settings {} {

   iForcePort [list "pdata_p\[1\]"] 0b0 -not_persistent
   iApply

   iReset
   iNote "Setting cpu_top_rtl2_tessent_tdr_sri_ctrl_inst.all_test to 1"
   iWrite cpu_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b0000
   iRead  cpu_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b0001
   iApply

   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iRead  cpu_top_rtl2_tessent_sib_sri_inst.sib 0b0
   iApply

   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_occ_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_occ_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iRead  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iRead  cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iApply

   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_occ_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_occ_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0001000000
   iRead  cpu_top_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0000000000
   iWrite cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iRead  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iRead  cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iApply


}


iProcsForModule cpu_top

iTopProc go_nogo {} {

   iForcePort [list "pdata_p\[1\]"] 0b0 -not_persistent
   iApply

   iNote "Setting up MemoryBist controller cpu_top_rtl1_tessent_mbist_c1_controller_inst"
   iNote "Releasing asynchronous reset"
   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_occ_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_occ_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0001000000
   iRead  cpu_top_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0000000000
   iWrite cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iRead  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iApply

   iWrite cpu_top_rtl1_tessent_sib_mbist_inst.sib 0b1
   iRead  cpu_top_rtl1_tessent_sib_mbist_inst.sib 0b0
   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  cpu_top_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_sri_inst.sib 0b0
   iApply

   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b1
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b1
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.ctl_group_sib
   iWrite cpu_top_rtl1_tessent_sib_mbist_inst.sib 0b1
   iRead  cpu_top_rtl1_tessent_sib_mbist_inst.sib 0b1
   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  cpu_top_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_sri_inst.sib 0b0
   iApply

   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b000
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0]
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr 0b1
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.INCLUDE_MEM_RESULTS_REG_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.INCLUDE_MEM_RESULTS_REG_tdr
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr 0b1
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE1_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE1_tdr
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE0_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE0_tdr
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.BIST_SELECT_TEST_DATA_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.BIST_SELECT_TEST_DATA_tdr
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.REDUCED_ADDRESS_COUNT_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.REDUCED_ADDRESS_COUNT_tdr
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b1
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.mbist_done_0 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.mbist_go_0 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b1
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b0
   iWrite cpu_top_rtl1_tessent_sib_mbist_inst.sib 0b1
   iRead  cpu_top_rtl1_tessent_sib_mbist_inst.sib 0b1
   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  cpu_top_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iRead  cpu_top_rtl2_tessent_sib_sri_inst.sib 0b0
   iApply

   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b000
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0bX00
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr 0b0
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr 0b1
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.INCLUDE_MEM_RESULTS_REG_tdr 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr 0b0
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr 0b0
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr 0b1
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr 0b1
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr 0b0
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE1_tdr 0b0
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE1_tdr 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE0_tdr 0b0
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE0_tdr 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.BIST_SELECT_TEST_DATA_tdr 0b0
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.BIST_SELECT_TEST_DATA_tdr 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.REDUCED_ADDRESS_COUNT_tdr 0b0
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.REDUCED_ADDRESS_COUNT_tdr 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr 0b0
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b1
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.mbist_done_0 0b0
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.mbist_go_0 0b1
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b1
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b0
   iWrite cpu_top_rtl1_tessent_sib_mbist_inst.sib 0b1
   iRead  cpu_top_rtl1_tessent_sib_mbist_inst.sib 0b1
   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  cpu_top_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_occ_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_occ_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0001000000
   iRead  cpu_top_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0000000000
   iWrite cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iRead  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Enabling reduced address simulation"
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b001
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b000
   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr 0b0
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr 0b0
