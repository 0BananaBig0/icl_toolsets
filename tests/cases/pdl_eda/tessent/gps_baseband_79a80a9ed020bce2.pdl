iProcsForModule gps_baseband_rtl1_tessent_occ

iProc setup {args} {  
    if {[expr [llength $args]%2 != 0]} {
     display_message -error "Odd number of arguments. Expecting parameter and value pairs."
     return -code error
  }
  set fast_capture_mode 0
  set parent_mode 0
  set capture_window_size 3
  set inject_tck 0
  set active_upstream_parent_occ 0
  foreach {param value} $args {
     set param [string tolower $param]
     if {$param eq "capture_window_size"} {
        set capture_window_size $value
     } elseif {$param eq "fast_capture_mode"} {
        set fast_capture_mode $value
     } elseif {$param eq "active_upstream_parent_occ"} {
        set active_upstream_parent_occ $value
     } elseif {$param eq "inject_tck"} {
        set inject_tck $value
     } else {
        display_message -error "Invalid parameter '$param'. Valid parameters are 'fast_capture_mode', 'capture_window_size', 'active_upstream_parent_occ' and 'inject_tck'."
        return -code error
     }
  }
  
  if {![string is boolean -strict $fast_capture_mode]} {
     display_message -error "Invalid non-boolean value '$fast_capture_mode' for parameter 'fast_capture_mode'."
     return -code error
  }
  if {![string is boolean -strict $active_upstream_parent_occ]} {
     display_message -error "Invalid non-boolean value '$active_upstream_parent_occ' for parameter 'active_upstream_parent_occ'."
     return -code error
  }
  if {![string is boolean -strict $parent_mode]} {
     display_message -error "Invalid non-boolean value '$parent_mode' for parameter 'parent_mode'."
     return -code error
  } elseif {$parent_mode} {
     display_message -error "Parameter 'parent_mode' cannot be set to 1 as the controller type is not 'parent'."
     return -code error
  }
  if {![string is integer -strict $capture_window_size]} {
     display_message -error "Invalid non-integer value '$capture_window_size' for parameter 'capture_window_size'."
     return -code error
  }
  if {$capture_window_size < 1 || $capture_window_size > 3} {
     display_message -error "Invalid value '$capture_window_size' for parameter 'capture_window_size'. Must be 1 to 3."
     return -code error
  }
  if {![string is boolean -strict $inject_tck]} {
     display_message -error "Invalid non-boolean value '$inject_tck' for parameter 'inject_tck'."
     return -code error
  }
  
  iWrite test_mode 1;
  iWrite fast_capture_mode [string is true $fast_capture_mode];
  iWrite capture_cycle_width [expr {$capture_window_size - 1}];
  iWrite active_upstream_parent_occ  [string is true $active_upstream_parent_occ]
  iWrite inject_tck [string is true $inject_tck];
  
  iApply;
} 

iProcsForModule gps_baseband_rtl1_tessent_ssn_scan_host_1

iProc end {args} {  
    array set ARGS {
    sticky_status_global                 1
    expect                               pass
  }
  array set ARGS $args
  
  set error_status_needed 0
  
  if {$ARGS(sticky_status_global) in {0b1 1} && $ARGS(expect) ni {pass fail}} {
    display_message "The iProc [get_icl_scope -icall].end was called with expect value '$ARGS(expect)' which is not one of 'pass' or 'fail'."
    set error_status_needed 1
  }
  if {$error_status_needed} {
    return -code error
  }
  iNote "TESSENT_PRAGMA iWriteVar enable inner.enable"
  iWrite inner.enable 1
  if {$ARGS(sticky_status_global) in {0b1 1}} {
    iNote "TESSENT_PRAGMA iReadVar sticky_status inner.sticky_status"
    iRead inner.sticky_status $ARGS(expect)
  }
  iApply
}

iProc setup {args} {  
    set param_list {
    packet_size 
    timeslot_sharing_count_minus_one 
    timeslot_sharing_offset
    force_suppress_capture
    bus_width
    min_shift_clock_low_width 
    min_capture_clock_low_width 
    enable   
    loop_back_en 
    streaming_through_ijtag_en
    initial_bit0_position 
    initial_offset
    relative_initial_offset_enable
    bits_per_packet
    extra_shift_packets
    scan_en_transition_packets
    scan_en_launch_packet
    edt_update_falling_transition_words
    edt_update_falling_launch_word
    total_shift_cnt_minus_one
    init_scan_load_used
    disable_first_scan_load_masking
    capture_packets
    packets_per_capture_clock_minus_one
    infinite_shift_mode
    on_chip_compare_enable
    disable_on_chip_compare_contribution
    on_chip_compare_group_count
    on_chip_compare_group
  }
  lappend param_list to_scan_in_bits
  lappend param_list from_scan_out_bits
  lappend param_list from_scan_out_le_strobe_en
  array set PARAM {
    enable                               0
    timeslot_sharing_count_minus_one     0
    timeslot_sharing_offset              0
    force_suppress_capture               0
    min_shift_clock_low_width            0 
    min_capture_clock_low_width          0 
    loop_back_en                         0 
    streaming_through_ijtag_en           0
    relative_initial_offset_enable       0
    init_scan_load_used                  0
    disable_first_scan_load_masking      0
    packets_per_capture_clock_minus_one  0
    extra_shift_packets                  0
    scan_en_transition_packets           0
    edt_update_falling_transition_words  0
    infinite_shift_mode                  0
    on_chip_compare_enable               0 
    disable_on_chip_compare_contribution 0
    on_chip_compare_group_count          1
    on_chip_compare_group                0
    from_scan_out_le_strobe_en           0
  }
  array set PARAM $args
  if {[getenv INIT_SCAN_LOAD_USED -default 0] eq "1"} {
    set PARAM(init_scan_load_used) 1
  }
  if {[getenv INFINITE_SHIFT_MODE -default 0] eq "1"} {
    set PARAM(infinite_shift_mode) 1
  }
  foreach {param value} $args {
    if {$param ni $param_list} {
      display_message -warning "Unknown argument '$param' passed to the setup iProc of module gps_baseband_rtl1_tessent_ssn_scan_host_1. It is ignored."
    }
  }
  set missing_param 0
  set disable_on_chip_compare_contribution_error 0
  if {$PARAM(on_chip_compare_enable) in {1 0b1}} {
    iNote "tessent_pragma iWriteVar disable_on_chip_compare_contribution inner.disable_on_chip_compare_contribution"
  }
  if {![info exists PARAM(streaming_through_ijtag_en)] || $PARAM(streaming_through_ijtag_en) in {0 0b0}} {
    iNote "tessent_pragma iWriteVar enable inner.enable"
  }
  foreach param $param_list {
    if {$PARAM(infinite_shift_mode)} {
      if {$param eq "total_shift_cnt_minus_one"} {
        continue
      }
    } else {
      if {$param eq "infinite_shift_mode"} {
        continue
      }
    }
    if {$param eq "bits_per_packet"} {
      if {$PARAM(timeslot_sharing_count_minus_one) > 0 && $PARAM(bits_per_packet) != 1} {
        display_message "The parameter bits_per_packet value '$PARAM(bits_per_packet)' must be 1 when timeslot_sharing_count_minus_one is greather than 0."
        return -code error
      }
    }
    if {$param eq "scan_en_launch_packet" && ![info exists PARAM(scan_en_launch_packet)] && [info exists PARAM(scan_en_transition_packets)]} {
      set PARAM(scan_en_launch_packet) [expr {int(ceil($PARAM(scan_en_transition_packets)/2))}]
    }
    if {$param eq "edt_update_falling_launch_word" && ![info exists PARAM(edt_update_falling_launch_word)] && [info exists PARAM(edt_update_falling_transition_words)]} {
      set PARAM(edt_update_falling_launch_word) [expr {int(ceil($PARAM(edt_update_falling_transition_words)/2))}]
    }
    if {![info exists PARAM($param)]} {
      display_message "Mandatory argument '$param' passed to the setup iProc of module gps_baseband_rtl1_tessent_ssn_scan_host_1 is missing."
      set missing_param 1
    } else {
      if {$param eq "disable_on_chip_compare_contribution" &&  [info exists ::ssh_disable_contribution_icl_instance_name_list] &&  [get_icl_scope -icall] in $::ssh_disable_contribution_icl_instance_name_list} {
        if {$PARAM(on_chip_compare_enable) ni {1 0b1}} {
          display_message "'disable_on_chip_compare_contribution' bit cannot be set when 'on_chip_compare_enable' is set to 'off'."
          set disable_on_chip_compare_contribution_error 1
        } else {
          puts "Setting $param to 1 for ICL Instance '[get_icl_scope -icall]'."
          iWrite inner.${param} 0b1
        }
      } elseif {$param ne "enable" || $PARAM(streaming_through_ijtag_en) in {0 0b0}} {
        iWrite inner.${param} $PARAM($param)
      }
    }
  }
    if {$PARAM(timeslot_sharing_count_minus_one) > 0} {
      set error_status 0
      if {$PARAM(scan_en_transition_packets) == 0} {
        display_message "Unexpected condition encountered while programming SSH 'gps_baseband_rtl1_tessent_ssn_scan_host_1' for Hyper Throttling. \nPlease report this problem to Tessent customer support. \nThe parameter scan_en_transition_packets must be 1 or larger when timeslot_sharing_count_minus_one is greater than 0."
        set error_status 1
      }
      set non_throttleable_packet_count_no_capture [expr {$PARAM(extra_shift_packets) +  max(($PARAM(scan_en_transition_packets)-1),0)}]
      set non_throttleable_packet_count_for_capture [expr {$PARAM(capture_packets)*($PARAM(packets_per_capture_clock_minus_one)+1) +  $PARAM(scan_en_transition_packets)}]
      if {$non_throttleable_packet_count_no_capture%[expr {$PARAM(timeslot_sharing_count_minus_one)+1}] != 0} {
        display_message "Unexpected condition encountered while programming SSH 'gps_baseband_rtl1_tessent_ssn_scan_host_1' for Hyper Throttling. \nPlease report this problem to Tessent customer support. \nThe number of non-throttleable packets when capture is suppressed '$non_throttleable_packet_count_no_capture' must be a multiple of the timeslot_sharing_count_minus_one value plus one '[expr {$PARAM(timeslot_sharing_count_minus_one)+1}]'. \nThe number of non-throttleable packets when capture is suppressed is computed as follow: \nextra_shift_packets + max((scan_en_transition_packets - 1),0)."
        set error_status 1
      }
      if {$non_throttleable_packet_count_for_capture%[expr {$PARAM(timeslot_sharing_count_minus_one)+1}] != 0} {
        display_message "Unexpected condition encountered while programming SSH 'gps_baseband_rtl1_tessent_ssn_scan_host_1' for Hyper Throttling. \nPlease report this problem to Tessent customer support. \nThe number of extra non-throttleable packets when capture is not suppressed '$non_throttleable_packet_count_for_capture' must be a multiple of the timeslot_sharing_count_minus_one value plus one '[expr {$PARAM(timeslot_sharing_count_minus_one)+1}]'. \nThe number of extra non-throttleable packets when capture is not suppressed is computed as follow: \n(capture_packets*(packets_per_capture_clock_minus_one+1))+scan_en_transition_packets."
        set error_status 1
      }
      if {$error_status} {
        return -code error
      }
    }
  if {$missing_param || $disable_on_chip_compare_contribution_error} {
    return -code error
  }
  
  if {1.0*$PARAM(packet_size)/$PARAM(bus_width) < 2} {
    iWrite inner.packet_width_is_less_than_two_bus_clock 0b1
  } else {
    iWrite inner.packet_width_is_less_than_two_bus_clock 0b0
  }
  
  iWrite inner.config_sib_shift_reg 0b0
  iApply
} 
