   iWrite cpu_top_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b0
   iRead  cpu_top_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b1
   iWrite cpu_top_rtl1_tessent_sib_mbist_inst.sib 0b0
   iRead  cpu_top_rtl1_tessent_sib_mbist_inst.sib 0b1
   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection for scan mux cpu_top_rtl1_tessent_tap_main_inst.IRMux, selection 1: fsm.irSel = 1'b1 -> IRMux = instruction\[0\]"
   iNote "Scan in verification pattern to the following scan register:"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.instruction\[3:0\], load value = 1011"
   iWrite cpu_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b1011
   iRead  cpu_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b0001
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan register:"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.instruction\[3:0\], expected value = 1011"
   iWrite cpu_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b1111
   iRead  cpu_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b1011
   iApply


}
