iProcsForModule cpu_top

iTopProc cpu_top {} {

   iForcePort [list "pdata_p\[1\]"] 0b0 -not_persistent
   iApply

   iReset
   iNote "Activate selection of the following scan muxes:"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.DRMux, selection 0: instruction = 4'b1111 -> DRMux = bypass"
   iNote "Scan in verification pattern to the following scan register:"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.bypass, load value = 1"
   iWrite cpu_top_rtl1_tessent_tap_main_inst.bypass 0b1
   iRead  cpu_top_rtl1_tessent_tap_main_inst.bypass 0b0
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan register:"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.bypass, expected value = 1"
   iWrite cpu_top_rtl1_tessent_tap_main_inst.bypass 0b0
   iRead  cpu_top_rtl1_tessent_tap_main_inst.bypass 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.DRMux, selection 1: instruction = 4'b0000 -> DRMux = host_1_from_so"
   iNote "  cpu_top_rtl2_tessent_sib_sri_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  cpu_top_rtl1_tessent_sib_sti_inst.scan_in_mux, selection 2: sib, ltest_en = 2'bxx -> scan_in_mux = ijtag_si"
   iWrite cpu_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b0000
   iRead  cpu_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b0001
   iApply

   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  cpu_top_rtl1_tessent_sib_sti_inst.sib, load value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_sri_inst.sib, load value = 1"
   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan registers:"
   iNote "  cpu_top_rtl1_tessent_sib_sti_inst.sib, expected value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iRead  cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.DRMux, selection 1: instruction = 4'b0000 -> DRMux = host_1_from_so"
   iNote "  cpu_top_rtl2_tessent_sib_sri_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  cpu_top_rtl2_tessent_sib_occ_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  cpu_top_rtl2_tessent_sib_edt_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  cpu_top_rtl2_tessent_sib_lbist_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  cpu_top_rtl1_tessent_sib_sti_inst.scan_in_mux, selection 2: sib, ltest_en = 2'bxx -> scan_in_mux = ijtag_si"
   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  cpu_top_rtl1_tessent_sib_sti_inst.sib, load value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_lbist_inst.sib, load value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_edt_inst.sib, load value = 1"
   iNote "  cpu_top_rtl2_tessent_sib_occ_inst.sib, load value = 1"
   iNote "  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib, load value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_sri_inst.sib, load value = 1"
   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_edt_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_occ_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan registers:"
   iNote "  cpu_top_rtl1_tessent_sib_sti_inst.sib, expected value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_lbist_inst.sib, expected value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_edt_inst.sib, expected value = 1"
   iNote "  cpu_top_rtl2_tessent_sib_occ_inst.sib, expected value = 1"
   iNote "  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib, expected value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_edt_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_occ_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_occ_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iRead  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iRead  cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.DRMux, selection 1: instruction = 4'b0000 -> DRMux = host_1_from_so"
   iNote "  cpu_top_rtl2_tessent_sib_sri_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  cpu_top_rtl2_tessent_sib_occ_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  cpu_top_rtl2_tessent_sib_edt_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  cpu_top_rtl2_tessent_sib_lbist_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  cpu_top_rtl1_tessent_sib_sti_inst.scan_in_mux, selection 2: sib, ltest_en = 2'bxx -> scan_in_mux = ijtag_si"
   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  cpu_top_rtl1_tessent_sib_sti_inst.sib, load value = 1"
   iNote "  cpu_top_rtl2_tessent_sib_lbist_inst.sib, load value = 1"
   iNote "  cpu_top_rtl2_tessent_sib_edt_inst.sib, load value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_occ_inst.sib, load value = 0"
   iNote "  cpu_top_rtl2_tessent_tdr_sri_ctrl_inst.tdr\[9:0\], load value = 1100111100"
   iNote "  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib, load value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_sri_inst.sib, load value = 1"
   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_occ_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b1100111100
   iRead  cpu_top_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0000000000
   iWrite cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan registers:"
   iNote "  cpu_top_rtl1_tessent_sib_sti_inst.sib, expected value = 1"
   iNote "  cpu_top_rtl2_tessent_sib_lbist_inst.sib, expected value = 1"
   iNote "  cpu_top_rtl2_tessent_sib_edt_inst.sib, expected value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_occ_inst.sib, expected value = 0"
   iNote "  cpu_top_rtl2_tessent_tdr_sri_ctrl_inst.tdr\[9:0\], expected value = 1100111100"
   iNote "  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib, expected value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  cpu_top_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_occ_inst.sib 0b1
   iRead  cpu_top_rtl2_tessent_sib_occ_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0000000000
   iRead  cpu_top_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b1100111100
   iWrite cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iRead  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iRead  cpu_top_rtl2_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  cpu_top_rtl1_tessent_tap_main_inst.DRMux, selection 1: instruction = 4'b0000 -> DRMux = host_1_from_so"
   iNote "  cpu_top_rtl2_tessent_sib_sri_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  cpu_top_rtl2_tessent_sib_occ_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  cpu_top_rtl2_tessent_occ_ramclk_p_inst.tdr_sib.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = scan_in"
   iNote "  cpu_top_rtl2_tessent_occ_clk4_inst.tdr_sib.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = scan_in"
   iNote "  cpu_top_rtl2_tessent_occ_clk3_inst.tdr_sib.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = scan_in"
   iNote "  cpu_top_rtl2_tessent_occ_clk2_inst.tdr_sib.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = scan_in"
   iNote "  cpu_top_rtl2_tessent_occ_clk1_inst.tdr_sib.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = scan_in"
   iNote "  cpu_top_rtl2_tessent_sib_edt_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  cpu_top_rtl2_tessent_sib_lbist_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  cpu_top_rtl1_tessent_sib_sti_inst.scan_in_mux, selection 2: sib, ltest_en = 2'bxx -> scan_in_mux = ijtag_si"
   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  cpu_top_rtl1_tessent_sib_sti_inst.sib, load value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_lbist_inst.sib, load value = 1"
   iNote "  cpu_top_rtl2_tessent_sib_edt_inst.sib, load value = 1"
   iNote "  cpu_top_rtl2_tessent_occ_clk1_inst.tdr_sib.sib, load value = 1"
   iNote "  cpu_top_rtl2_tessent_occ_clk2_inst.tdr_sib.sib, load value = 1"
   iNote "  cpu_top_rtl2_tessent_occ_clk3_inst.tdr_sib.sib, load value = 0"
   iNote "  cpu_top_rtl2_tessent_occ_clk4_inst.tdr_sib.sib, load value = 0"
   iNote "  cpu_top_rtl2_tessent_occ_ramclk_p_inst.tdr_sib.sib, load value = 1"
   iNote "  cpu_top_rtl2_tessent_sib_occ_inst.sib, load value = 1"
   iNote "  cpu_top_rtl2_tessent_sib_sri_ctrl_inst.sib, load value = 0"
   iNote "  cpu_top_rtl2_tessent_sib_sri_inst.sib, load value = 1"
   iWrite cpu_top_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite cpu_top_rtl2_tessent_sib_lbist_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_sib_edt_inst.sib 0b1
   iWrite cpu_top_rtl2_tessent_occ_clk1_inst.tdr_sib.sib 0b1
   iRead  cpu_top_rtl2_tessent_occ_clk1_inst.tdr_sib.sib 0b0
