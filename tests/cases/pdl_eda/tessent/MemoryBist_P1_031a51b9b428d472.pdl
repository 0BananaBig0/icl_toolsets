iProcsForModule processor_core

iProc go_nogo {} {

   iReset
   iNote "Setting up MemoryBist controller processor_core_rtl1_tessent_mbist_c1_controller_inst"
   iNote "Releasing asynchronous reset"
   iWrite processor_core_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  processor_core_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite processor_core_rtl2_tessent_sib_sri_inst.sib 0b0
   iRead  processor_core_rtl2_tessent_sib_sri_inst.sib 0b0
   iApply

   iWrite processor_core_rtl1_tessent_sib_mbist_inst.sib 0b1
   iRead  processor_core_rtl1_tessent_sib_mbist_inst.sib 0b0
   iWrite processor_core_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  processor_core_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite processor_core_rtl2_tessent_sib_sri_inst.sib 0b0
   iRead  processor_core_rtl2_tessent_sib_sri_inst.sib 0b0
   iApply

   iWrite processor_core_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b1
