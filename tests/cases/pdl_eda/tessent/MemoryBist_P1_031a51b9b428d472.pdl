   iWrite processor_core_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr 0b0
   iRead  processor_core_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr 0b0
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b1
   iRead  processor_core_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b0
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.mbist_done_0 0b0
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.mbist_go_0 0b1
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b1
   iRead  processor_core_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b0
   iWrite processor_core_rtl1_tessent_sib_mbist_inst.sib 0b1
   iRead  processor_core_rtl1_tessent_sib_mbist_inst.sib 0b1
   iWrite processor_core_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  processor_core_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite processor_core_rtl2_tessent_sib_ssn_inst.sib 0b0
   iRead  processor_core_rtl2_tessent_sib_ssn_inst.sib 0b0
   iWrite processor_core_rtl2_tessent_sib_occ_inst.sib 0b0
   iRead  processor_core_rtl2_tessent_sib_occ_inst.sib 0b0
   iWrite processor_core_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  processor_core_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite processor_core_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iRead  processor_core_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
