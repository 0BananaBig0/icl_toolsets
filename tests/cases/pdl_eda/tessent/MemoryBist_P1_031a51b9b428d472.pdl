   iRead  processor_core_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite processor_core_rtl2_tessent_sib_ssn_inst.sib 0b0
   iRead  processor_core_rtl2_tessent_sib_ssn_inst.sib 0b0
   iWrite processor_core_rtl2_tessent_sib_occ_inst.sib 0b0
   iRead  processor_core_rtl2_tessent_sib_occ_inst.sib 0b0
   iWrite processor_core_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  processor_core_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite processor_core_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0000000000
   iRead  processor_core_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0000000000
   iWrite processor_core_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iRead  processor_core_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iWrite processor_core_rtl2_tessent_sib_sri_inst.sib 0b0
   iRead  processor_core_rtl2_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Enabling reduced address simulation"
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b001
   iRead  processor_core_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b000
