   iRead  processor_core_rtl2_tessent_sib_sri_inst.sib 0b0
   iApply

   iRunLoop 1 -tck
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b011
   iRead  processor_core_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0bX01
