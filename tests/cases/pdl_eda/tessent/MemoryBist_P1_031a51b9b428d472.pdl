   iNote "tessent_pragma optional_iRead"
   iRead  processor_core_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE0_tdr
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.BIST_SELECT_TEST_DATA_tdr 0b0
   iNote "tessent_pragma optional_iRead"
