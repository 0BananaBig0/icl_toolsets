   iWrite processor_core_rtl1_tessent_mbist_c1_controller_inst.A_ADD_REG_Y_HW[0:3] 0b0000
   iWrite processor_core_rtl1_tessent_mbist_c1_controller_inst.A_ADD_REG_X_HW[0:8] 0b000000000
