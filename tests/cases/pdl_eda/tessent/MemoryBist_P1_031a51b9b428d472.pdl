   iWrite processor_core_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  processor_core_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b1
   iRead  processor_core_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b0
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.mbist_done_0 0b0
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.mbist_go_0 0b0
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b1
   iRead  processor_core_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b0
   iWrite processor_core_rtl1_tessent_sib_mbist_inst.sib 0b1
   iRead  processor_core_rtl1_tessent_sib_mbist_inst.sib 0b1
   iWrite processor_core_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  processor_core_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite processor_core_rtl2_tessent_sib_sri_inst.sib 0b1
   iRead  processor_core_rtl2_tessent_sib_sri_inst.sib 0b0
   iApply

   iWrite processor_core_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b000
   iRead  processor_core_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0bX00
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr 0b0
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.INCLUDE_MEM_RESULTS_REG_tdr 0b0
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr 0b0
