   iRead  processor_core_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr 0b0
   iWrite processor_core_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE1_tdr 0b0
