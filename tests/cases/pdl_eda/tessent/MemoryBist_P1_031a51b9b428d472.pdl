   iWrite processor_core_rtl1_tessent_mbist_c1_controller_inst.STOP_ERROR_CNT_REG_HW[0:11] 0b000000000000
   iWrite processor_core_rtl1_tessent_mbist_c1_controller_inst.STEP_COUNTER_FREEZE_REG[0] 0b0
