iProcsForModule chip_top

iProc chip_top {} {

   iReset
   iNote "Activate selection of the following scan muxes:"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.DRMux, selection 0: instruction = 4'b1111 -> DRMux = bypass"
   iNote "Scan in verification pattern to the following scan register:"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.bypass, load value = 1"
   iWrite chip_top_rtl1_tessent_tap_main_inst.bypass 0b1
   iRead  chip_top_rtl1_tessent_tap_main_inst.bypass 0b0
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan register:"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.bypass, expected value = 1"
   iWrite chip_top_rtl1_tessent_tap_main_inst.bypass 0b0
   iRead  chip_top_rtl1_tessent_tap_main_inst.bypass 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.DRMux, selection 1: instruction = 4'b0000 -> DRMux = host_1_from_so"
   iNote "  chip_top_rtl1_tessent_sib_sri_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iWrite chip_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b0000
   iRead  chip_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b0001
   iApply

   iNote "Scan in verification pattern to the following scan register:"
   iNote "  chip_top_rtl1_tessent_sib_sri_inst.sib, load value = 1"
   iWrite chip_top_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan register:"
   iNote "  chip_top_rtl1_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite chip_top_rtl1_tessent_sib_sri_inst.sib 0b1
   iRead  chip_top_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.DRMux, selection 1: instruction = 4'b0000 -> DRMux = host_1_from_so"
   iNote "  chip_top_rtl1_tessent_sib_sri_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  chip_top_rtl1_tessent_sib_pb1_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  chip_top_rtl1_tessent_sib_pb2_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  chip_top_rtl1_tessent_sib_pb3_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  chip_top_rtl1_tessent_sib_sri_ctrl_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  chip_top_rtl1_tessent_sib_sri_ctrl_inst.sib, load value = 0"
   iNote "  chip_top_rtl1_tessent_sib_pb3_inst.sib, load value = 1"
   iNote "  chip_top_rtl1_tessent_sib_pb2_inst.sib, load value = 1"
   iNote "  chip_top_rtl1_tessent_sib_pb1_inst.sib, load value = 0"
   iNote "  chip_top_rtl1_tessent_sib_sri_inst.sib, load value = 1"
   iWrite chip_top_rtl1_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite chip_top_rtl1_tessent_sib_pb3_inst.sib 0b1
   iWrite chip_top_rtl1_tessent_sib_pb2_inst.sib 0b1
   iWrite chip_top_rtl1_tessent_sib_pb1_inst.sib 0b0
   iWrite chip_top_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan registers:"
   iNote "  chip_top_rtl1_tessent_sib_sri_ctrl_inst.sib, expected value = 0"
   iNote "  chip_top_rtl1_tessent_sib_pb3_inst.sib, expected value = 1"
   iNote "  chip_top_rtl1_tessent_sib_pb2_inst.sib, expected value = 1"
   iNote "  chip_top_rtl1_tessent_sib_pb1_inst.sib, expected value = 0"
   iNote "  chip_top_rtl1_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite chip_top_rtl1_tessent_sib_sri_ctrl_inst.sib 0b1
   iRead  chip_top_rtl1_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite chip_top_rtl1_tessent_sib_pb3_inst.sib 0b0
   iRead  chip_top_rtl1_tessent_sib_pb3_inst.sib 0b1
   iWrite chip_top_rtl1_tessent_sib_pb2_inst.sib 0b0
   iRead  chip_top_rtl1_tessent_sib_pb2_inst.sib 0b1
   iWrite chip_top_rtl1_tessent_sib_pb1_inst.sib 0b0
   iRead  chip_top_rtl1_tessent_sib_pb1_inst.sib 0b0
   iWrite chip_top_rtl1_tessent_sib_sri_inst.sib 0b1
   iRead  chip_top_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.DRMux, selection 1: instruction = 4'b0000 -> DRMux = host_1_from_so"
   iNote "  chip_top_rtl1_tessent_sib_sri_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  chip_top_rtl1_tessent_sib_pb1_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  chip_top_rtl1_tessent_sib_pb2_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  chip_top_rtl1_tessent_sib_pb3_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  chip_top_rtl1_tessent_sib_sri_ctrl_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  chip_top_rtl1_tessent_tdr_sri_ctrl_inst.tdr\[0:0\], load value = 0"
   iNote "  chip_top_rtl1_tessent_sib_sri_ctrl_inst.sib, load value = 0"
   iNote "  chip_top_rtl1_tessent_sib_pb3_inst.sib, load value = 1"
   iNote "  chip_top_rtl1_tessent_sib_pb2_inst.sib, load value = 1"
   iNote "  chip_top_rtl1_tessent_sib_pb1_inst.sib, load value = 0"
   iNote "  chip_top_rtl1_tessent_sib_sri_inst.sib, load value = 1"
   iWrite chip_top_rtl1_tessent_tdr_sri_ctrl_inst.tdr[0] 0b0
   iRead  chip_top_rtl1_tessent_tdr_sri_ctrl_inst.tdr[0] 0b0
   iWrite chip_top_rtl1_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite chip_top_rtl1_tessent_sib_pb3_inst.sib 0b1
   iWrite chip_top_rtl1_tessent_sib_pb2_inst.sib 0b1
   iWrite chip_top_rtl1_tessent_sib_pb1_inst.sib 0b0
   iWrite chip_top_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan registers:"
   iNote "  chip_top_rtl1_tessent_tdr_sri_ctrl_inst.tdr\[0:0\], expected value = 0"
   iNote "  chip_top_rtl1_tessent_sib_sri_ctrl_inst.sib, expected value = 0"
   iNote "  chip_top_rtl1_tessent_sib_pb3_inst.sib, expected value = 1"
   iNote "  chip_top_rtl1_tessent_sib_pb2_inst.sib, expected value = 1"
   iNote "  chip_top_rtl1_tessent_sib_pb1_inst.sib, expected value = 0"
   iNote "  chip_top_rtl1_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite chip_top_rtl1_tessent_tdr_sri_ctrl_inst.tdr[0] 0b0
   iRead  chip_top_rtl1_tessent_tdr_sri_ctrl_inst.tdr[0] 0b0
   iWrite chip_top_rtl1_tessent_sib_sri_ctrl_inst.sib 0b0
   iRead  chip_top_rtl1_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite chip_top_rtl1_tessent_sib_pb3_inst.sib 0b0
   iRead  chip_top_rtl1_tessent_sib_pb3_inst.sib 0b1
   iWrite chip_top_rtl1_tessent_sib_pb2_inst.sib 0b0
   iRead  chip_top_rtl1_tessent_sib_pb2_inst.sib 0b1
   iWrite chip_top_rtl1_tessent_sib_pb1_inst.sib 0b0
   iRead  chip_top_rtl1_tessent_sib_pb1_inst.sib 0b0
   iWrite chip_top_rtl1_tessent_sib_sri_inst.sib 0b0
   iRead  chip_top_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection for scan mux chip_top_rtl1_tessent_tap_main_inst.IRMux, selection 1: fsm.irSel = 1'b1 -> IRMux = instruction\[0\]"
   iNote "Scan in verification pattern to the following scan register:"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.instruction\[3:0\], load value = 1011"
   iWrite chip_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b1011
   iRead  chip_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b0001
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan register:"
   iNote "  chip_top_rtl1_tessent_tap_main_inst.instruction\[3:0\], expected value = 1011"
   iWrite chip_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b1111
   iRead  chip_top_rtl1_tessent_tap_main_inst.instruction[3:0] 0b1011
   iApply


}
