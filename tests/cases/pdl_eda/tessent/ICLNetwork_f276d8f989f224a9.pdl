iProcsForModule piccpu

iTopProc piccpu {} {

   iForcePort [list "scan_en"] 0b0 -not_persistent
   iApply

   iReset
   iNote "Activate selection of the following scan muxes:"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.scan_in_mux, selection 2: sib, ltest_en = 2'bxx -> scan_in_mux = ijtag_si"
   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.sib, load value = 0"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.sib, load value = 1"
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan registers:"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.sib, expected value = 0"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  piccpu_rtl2_tessent_sib_sri_ctrl_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl2_tessent_sib_occ_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl2_tessent_sib_edt_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl2_tessent_sib_lbist_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.scan_in_mux, selection 2: sib, ltest_en = 2'bxx -> scan_in_mux = ijtag_si"
   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.sib, load value = 1"
   iNote "  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr\[1:0\], load value = 01"
   iNote "  piccpu_rtl2_tessent_sib_lbist_inst.sib, load value = 0"
   iNote "  piccpu_rtl2_tessent_sib_edt_inst.sib, load value = 1"
   iNote "  piccpu_rtl2_tessent_sib_occ_inst.sib, load value = 1"
   iNote "  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib, load value = 0"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.sib, load value = 1"
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b01
   iRead  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iWrite piccpu_rtl2_tessent_sib_lbist_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_edt_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_occ_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan registers:"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.sib, expected value = 1"
   iNote "  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr\[1:0\], expected value = 01"
   iNote "  piccpu_rtl2_tessent_sib_lbist_inst.sib, expected value = 0"
   iNote "  piccpu_rtl2_tessent_sib_edt_inst.sib, expected value = 1"
   iNote "  piccpu_rtl2_tessent_sib_occ_inst.sib, expected value = 1"
   iNote "  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib, expected value = 0"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iRead  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b01
   iWrite piccpu_rtl2_tessent_sib_lbist_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_lbist_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_edt_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_occ_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_occ_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iRead  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  piccpu_rtl2_tessent_sib_sri_ctrl_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  piccpu_rtl2_tessent_sib_occ_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl2_tessent_sib_edt_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl2_tessent_sib_lbist_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.scan_in_mux, selection 2: sib, ltest_en = 2'bxx -> scan_in_mux = ijtag_si"
   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.sib, load value = 1"
   iNote "  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr\[1:0\], load value = 11"
   iNote "  piccpu_rtl2_tessent_sib_lbist_inst.sib, load value = 1"
   iNote "  piccpu_rtl2_tessent_sib_edt_inst.sib, load value = 0"
   iNote "  piccpu_rtl2_tessent_sib_occ_inst.sib, load value = 0"
   iNote "  piccpu_rtl2_tessent_tdr_sri_ctrl_inst.tdr\[9:0\], load value = 1100111100"
   iNote "  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib, load value = 0"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.sib, load value = 1"
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b11
   iRead  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iWrite piccpu_rtl2_tessent_sib_lbist_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_occ_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b1100111100
   iRead  piccpu_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0000000000
   iWrite piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan registers:"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.sib, expected value = 1"
   iNote "  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr\[1:0\], expected value = 11"
   iNote "  piccpu_rtl2_tessent_sib_lbist_inst.sib, expected value = 1"
   iNote "  piccpu_rtl2_tessent_sib_edt_inst.sib, expected value = 0"
   iNote "  piccpu_rtl2_tessent_sib_occ_inst.sib, expected value = 0"
   iNote "  piccpu_rtl2_tessent_tdr_sri_ctrl_inst.tdr\[9:0\], expected value = 1100111100"
   iNote "  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib, expected value = 0"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iRead  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b11
   iWrite piccpu_rtl2_tessent_sib_lbist_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_lbist_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_occ_inst.sib 0b1
   iRead  piccpu_rtl2_tessent_sib_occ_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0000000000
   iRead  piccpu_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b1100111100
   iWrite piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  piccpu_rtl2_tessent_sib_sri_ctrl_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl2_tessent_sib_occ_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = scan_in"
   iNote "  piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = scan_in"
   iNote "  piccpu_rtl2_tessent_sib_edt_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl2_tessent_sib_lbist_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.scan_in_mux, selection 2: sib, ltest_en = 2'bxx -> scan_in_mux = ijtag_si"
   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.sib, load value = 1"
   iNote "  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr\[1:0\], load value = 11"
   iNote "  piccpu_rtl2_tessent_sib_lbist_inst.sib, load value = 1"
   iNote "  piccpu_rtl2_tessent_sib_edt_inst.sib, load value = 0"
   iNote "  piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib, load value = 0"
   iNote "  piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib, load value = 1"
   iNote "  piccpu_rtl2_tessent_sib_occ_inst.sib, load value = 1"
   iNote "  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib, load value = 0"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.sib, load value = 1"
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b11
   iRead  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iWrite piccpu_rtl2_tessent_sib_lbist_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib 0b0
   iRead  piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib 0b0
   iWrite piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib 0b1
   iRead  piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_occ_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan registers:"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.sib, expected value = 1"
   iNote "  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr\[1:0\], expected value = 11"
   iNote "  piccpu_rtl2_tessent_sib_lbist_inst.sib, expected value = 1"
   iNote "  piccpu_rtl2_tessent_sib_edt_inst.sib, expected value = 0"
   iNote "  piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib, expected value = 0"
   iNote "  piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib, expected value = 1"
   iNote "  piccpu_rtl2_tessent_sib_occ_inst.sib, expected value = 1"
   iNote "  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib, expected value = 0"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iRead  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b11
   iWrite piccpu_rtl2_tessent_sib_lbist_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_lbist_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib 0b0
   iRead  piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib 0b0
   iWrite piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib 0b1
   iRead  piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_occ_inst.sib 0b1
   iRead  piccpu_rtl2_tessent_sib_occ_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  piccpu_rtl2_tessent_sib_sri_ctrl_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl2_tessent_sib_occ_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = from_scan_out"
   iNote "  piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = scan_in"
   iNote "  piccpu_rtl2_tessent_sib_edt_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl2_tessent_sib_lbist_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.scan_in_mux, selection 2: sib, ltest_en = 2'bxx -> scan_in_mux = ijtag_si"
   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.sib, load value = 1"
   iNote "  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr\[1:0\], load value = 11"
   iNote "  piccpu_rtl2_tessent_sib_lbist_inst.sib, load value = 1"
   iNote "  piccpu_rtl2_tessent_sib_edt_inst.sib, load value = 1"
   iNote "  piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib, load value = 1"
   iNote "  piccpu_rtl2_tessent_occ_ramclk_inst.tdr\[9:0\], load value = 0011110000"
   iNote "  piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib, load value = 1"
   iNote "  piccpu_rtl2_tessent_sib_occ_inst.sib, load value = 1"
   iNote "  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib, load value = 0"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.sib, load value = 1"
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b11
   iRead  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iWrite piccpu_rtl2_tessent_sib_lbist_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_edt_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib 0b1
   iRead  piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib 0b0
   iWrite piccpu_rtl2_tessent_occ_ramclk_inst.tdr[9:0] 0b0011110000
   iRead  piccpu_rtl2_tessent_occ_ramclk_inst.tdr[9:0] 0b0000000000
   iWrite piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib 0b1
   iRead  piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_occ_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan registers:"
   iNote "  piccpu_rtl1_tessent_sib_sti_inst.sib, expected value = 1"
   iNote "  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr\[1:0\], expected value = 11"
   iNote "  piccpu_rtl2_tessent_sib_lbist_inst.sib, expected value = 1"
   iNote "  piccpu_rtl2_tessent_sib_edt_inst.sib, expected value = 1"
   iNote "  piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib, expected value = 1"
   iNote "  piccpu_rtl2_tessent_occ_ramclk_inst.tdr\[9:0\], expected value = 0011110000"
   iNote "  piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib, expected value = 1"
   iNote "  piccpu_rtl2_tessent_sib_occ_inst.sib, expected value = 1"
   iNote "  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib, expected value = 0"
   iNote "  piccpu_rtl1_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iRead  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b11
   iWrite piccpu_rtl2_tessent_sib_lbist_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_lbist_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_edt_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib 0b1
   iRead  piccpu_rtl2_tessent_occ_clk_inst.tdr_sib.sib 0b1
   iWrite piccpu_rtl2_tessent_occ_ramclk_inst.tdr[9:0] 0b0000000000
   iRead  piccpu_rtl2_tessent_occ_ramclk_inst.tdr[9:0] 0b0011110000
   iWrite piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib 0b0
   iRead  piccpu_rtl2_tessent_occ_ramclk_inst.tdr_sib.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_occ_inst.sib 0b1
   iRead  piccpu_rtl2_tessent_sib_occ_inst.sib 0b1
   iWrite piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply

