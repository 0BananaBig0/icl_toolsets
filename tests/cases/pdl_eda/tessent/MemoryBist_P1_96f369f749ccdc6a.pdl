iProcsForModule piccpu

iTopProc go_nogo_initial_settings {} {

   iForcePort [list "scan_en"] 0b0 -not_persistent
   iApply

   iReset

}


iProcsForModule piccpu

iTopProc go_nogo {} {

   iForcePort [list "scan_en"] 0b0 -not_persistent
   iApply

   iNote "Setting up MemoryBist controller regs_piccpu_rtl1_tessent_mbist_c1_controller_inst"
   iNote "Releasing asynchronous reset"
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b0
   iApply

   iWrite piccpu_rtl1_tessent_sib_mbist_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_mbist_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b0
   iApply

   iWrite piccpu_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b1
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b1
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.ctl_group_sib
   iWrite piccpu_rtl1_tessent_sib_mbist_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_mbist_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b0
   iApply

   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b000
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0]
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr 0b1
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.INCLUDE_MEM_RESULTS_REG_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.INCLUDE_MEM_RESULTS_REG_tdr
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr 0b1
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE1_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE1_tdr
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE0_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE0_tdr
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_SELECT_TEST_DATA_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_SELECT_TEST_DATA_tdr
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.REDUCED_ADDRESS_COUNT_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.REDUCED_ADDRESS_COUNT_tdr
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr 0b0
   iNote "tessent_pragma optional_iRead"
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b1
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.mbist_done_0 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.mbist_go_0 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b1
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b0
   iWrite piccpu_rtl1_tessent_sib_mbist_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_mbist_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b0
   iApply

   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iRead  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iWrite piccpu_rtl2_tessent_sib_lbist_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_lbist_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_occ_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_occ_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iRead  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply

   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b000
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0bX00
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.INCLUDE_MEM_RESULTS_REG_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr 0b1
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr 0b1
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE1_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE1_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE0_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE0_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_SELECT_TEST_DATA_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_SELECT_TEST_DATA_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.REDUCED_ADDRESS_COUNT_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.REDUCED_ADDRESS_COUNT_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b1
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.mbist_done_0 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.mbist_go_0 0b1
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b1
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b0
   iWrite piccpu_rtl1_tessent_sib_mbist_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_mbist_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iRead  piccpu_rtl1_tessent_tdr_sri_ctrl_inst.tdr[1:0] 0b00
   iWrite piccpu_rtl2_tessent_sib_lbist_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_lbist_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_edt_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_sib_occ_inst.sib 0b0
   iRead  piccpu_rtl2_tessent_sib_occ_inst.sib 0b0
   iWrite piccpu_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0000000000
   iRead  piccpu_rtl2_tessent_tdr_sri_ctrl_inst.tdr[9:0] 0b0000000000
   iWrite piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iRead  piccpu_rtl2_tessent_sib_sri_ctrl_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Enabling reduced address simulation"
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b001
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b000
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.INCLUDE_MEM_RESULTS_REG_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.INCLUDE_MEM_RESULTS_REG_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr 0b1
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr 0b1
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE1_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE1_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE0_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE0_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_SELECT_TEST_DATA_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_SELECT_TEST_DATA_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.REDUCED_ADDRESS_COUNT_tdr 0b1
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.REDUCED_ADDRESS_COUNT_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b1
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.BIST_SI_Pipeline 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.DIAG_EN_REG[0] 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.CMP_EN_MASK_EN[0] 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.CMP_EN_PARITY[0] 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.MEM_SELECT_REG0[0] 0b1
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.ALGO_SEL_CNT_REG[0] 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.SELECT_COMMON_OPSET_REG[0] 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.SELECT_COMMON_DATA_PAT_REG[0] 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.MICROCODE_EN_REG[0] 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.INST_POINTER_REG_HW[0:4] 0b00000
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.A_ADD_REG_X_HW[0:6] 0b0000000
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.B_ADD_REG_X_HW[0:6] 0b0000000
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.JCNT_HW[0:2] 0b000
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.OPSET_SELECT_REG[0] 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.WDATA_REG_HW[0:1] 0b00
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.EDATA_REG_HW[0:1] 0b00
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.X_ADDR_BIT_SEL_REG[0] 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.REPEATLOOP_A_CNTR_REG_HW[0:1] 0b00
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.REPEATLOOP_B_CNTR_REG_HW[0:1] 0b00
   iWrite regs_picdram_interface_inst.RA_STATUS_REG[0] 0b0
   iWrite regs_picdram_interface_inst.FREEZE_STOP_ERROR_REG[0] 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.STOP_ON_ERROR_REG[0] 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.FREEZE_STOP_ERROR_REG[0] 0b0
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.STOP_ERROR_CNT_REG_HW[0:11] 0b000000000000
   iWrite regs_piccpu_rtl1_tessent_mbist_c1_controller_inst.BIST_SO_Pipeline 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.mbist_done_0 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.mbist_go_0 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b0
   iWrite piccpu_rtl1_tessent_sib_mbist_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_mbist_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b0
   iApply

   #  Additional iApply to adjust iApplyEndState values
   iApply

   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b011
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0bX01
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.INCLUDE_MEM_RESULTS_REG_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr 0b1
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr 0b1
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE1_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE1_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE0_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_ALGO_MODE0_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_SELECT_TEST_DATA_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_SELECT_TEST_DATA_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.REDUCED_ADDRESS_COUNT_tdr 0b1
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.REDUCED_ADDRESS_COUNT_tdr 0b1
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.ENABLE_MEM_RESET_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b1
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.tdr_bypass_sib_inst 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b1
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.ctl_group_sib 0b0
   iWrite piccpu_rtl1_tessent_sib_mbist_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_mbist_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iRead  piccpu_rtl1_tessent_sib_sti_inst.sib 0b1
   iWrite piccpu_rtl1_tessent_sib_sri_inst.sib 0b0
   iRead  piccpu_rtl1_tessent_sib_sri_inst.sib 0b0
   #  Unlock iWrite targets with explicit_iwrite_only attribute:
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_SETUP[1] 0b1

   iApply

   #  Additional iApply to adjust iApplyEndState values
   iApply

   iNote "Checking GO is FAIL before execution"
   iNote "Checking DONE is FAIL before execution"
   iNote "Starting MemoryBist controller execution : regs_piccpu_rtl1_tessent_mbist_c1_controller_inst"
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b011
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_SETUP_tdr[2:0] 0b011
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.CHAIN_BYPASS_EN_tdr 0b1
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.INCLUDE_MEM_RESULTS_REG_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE1_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr 0b0
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.FL_CNT_MODE0_tdr 0b0
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr 0b1
   iRead  piccpu_rtl1_tessent_mbist_bap_inst.BIST_ASYNC_RESET_tdr 0b1
   iWrite piccpu_rtl1_tessent_mbist_bap_inst.BIST_DIAG_EN_tdr 0b0
