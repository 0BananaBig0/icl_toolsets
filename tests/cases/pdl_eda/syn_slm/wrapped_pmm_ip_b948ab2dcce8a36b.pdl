iPDLLevel 0 -version STD_1687_2014
iProcsForModule wrapped_pmm_ip
iProc verify {} {
  iNote -status "MODE: verify write PM_MODE_TDR : 6'b010100" ;
  iWrite PM_MODE_TDR 0b010100;
  iApply;
  iRunLoop -tck 4;
  iNote -status "MODE: verify read PM_MODE_TDR : 6'b010100" ;
  iRead PM_MODE_TDR 0b010100;
  iApply;
  iRunLoop -tck 4;
   
  iNote -status "MODE: verify write LOOP_BYPASS_TDR: 1'b0" ;
  iWrite LOOP_BYPASS_TDR 0b0;
  iApply;
  iNote -status "MODE: verify write SIB2_LOOP1_BYPASS_TDR: 1'b0" ;
  iWrite SIB2_LOOP1_BYPASS_TDR 0b0;
  iApply;
  iNote -status "MODE: verify write PATH_SEL_LOOP1: 180'b101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010" ;
  iWrite PATH_SEL_LOOP1 0b101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010;
  iApply;
  iNote -status "MODE: verify write DELAY_SEL_LOOP1 : 300'" ;
  iWrite DELAY_SEL_LOOP1 ;
  iApply;
  iNote -status "MODE: verify read PATH_SEL_LOOP1: 180'b101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010" ;
  iRead PATH_SEL_LOOP1 0b101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010;
  iApply;
  iNote -status "MODE: verify read DELAY_SEL_LOOP1 : 300'" ;
  iRead DELAY_SEL_LOOP1 ;
  iApply;
  iNote -status "MODE: verify write SIB2_LOOP1_BYPASS_TDR: 1'b1" ;
  iWrite SIB2_LOOP1_BYPASS_TDR 0b1;
  iApply;
  iNote -status "MODE: verify write LOOP_BYPASS_TDR: 1'b1" ;
  iWrite LOOP_BYPASS_TDR 0b1;
  iApply;
  iRunLoop -tck 4;
  iNote -status "MODE: verify write FUNC_CLK_TDR : 15'b000000000000001" ;
  iWrite FUNC_CLK_TDR 0b000000000000001;
  iApply;
  iRunLoop -tck 4;
  iNote -status "MODE: verify read FUNC_CLK_TDR : 15'b000000000000001" ;
  iRead FUNC_CLK_TDR 0b000000000000001;
  iApply;
  iRunLoop -tck 4;
  iNote -status "MODE: verify write FUNC_CLK_TDR : 15'b000000000000000" ;
  iWrite FUNC_CLK_TDR 0b000000000000000;
  iApply;
  iNote -status "MODE: verify read FUNC_CLK_TDR : 15'b000000000000000" ;
  iRead FUNC_CLK_TDR 0b000000000000000;
  iApply;
  iNote -status "MODE: verify write LOOP_BYPASS_TDR: 1'b0" ;
  iWrite LOOP_BYPASS_TDR 0b0;
  iApply;
  iNote -status "MODE: verify write SIB2_LOOP1_BYPASS_TDR: 1'b0" ;
  iWrite SIB2_LOOP1_BYPASS_TDR 0b0;
  iApply;
  iNote -status "MODE: verify read COLLECT_STATUS_TDR : 120'b0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x" ;
  iRead COLLECT_LOOP1 0b0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x0x;
  iApply;
  iNote -status "MODE: verify read CAPTURE_LOOP1 : 120'bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" ;
  iRead CAPTURE_LOOP1 0bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx;
  iApply;
  iNote -status "MODE: verify write SIB2_LOOP1_BYPASS_TDR: 1'b1" ;
  iWrite SIB2_LOOP1_BYPASS_TDR 0b1;
  iApply;
  iNote -status "MODE: verify write LOOP_BYPASS_TDR: 1'b1" ;
  iWrite LOOP_BYPASS_TDR 0b1;
  iApply;
}
  
