Module m {
  Instance i Of M {
    // Attribute names may be keywords: the scanner knows them, but inside a
    // block they are just names. These are the ones the corpus never used.
    Module 1;
    Alias 2;
    SelectedBy 3;
    LogicSignal 4;
    Connection 5;
    PortGroup 6;
    Of 7;
    LocalParameter 8;
    NameSpace 9;
    UseNameSpace 10;
    Attribute;
  }
}
