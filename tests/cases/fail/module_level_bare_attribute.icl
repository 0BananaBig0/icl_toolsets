Module TDR {
  // From a SemiWiki article, where `CaptureEnport` is printed with a
  // lower-case p. At module level the published grammar admits only
  // attribute_def — a statement beginning with the keyword Attribute — so a
  // bare `name value;` is not a module item and is rejected. The same line
  // inside a block would be accepted.
  CaptureEnport CE;
}
