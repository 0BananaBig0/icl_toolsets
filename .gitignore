# Everything below is produced by `make`, by a test run, or by a coverage or
# packaging step. None of it belongs in git. An optional local distribution
# may bundle generated parser/scanner sources without tracking them here.
#
# Note for anyone editing this file: gitignore has no end-of-line comments.
# A `#` after a pattern is part of the pattern, so every comment here is on
# its own line. An earlier version of this file put the comments on the right
# and silently ignored nothing at all.

# make: all object files, binaries, and gen/ when PREBUILT=0
build/

# the parser/scanner shipped inside a `make dist` tarball
gen/

# the marker that switches the build to ./gen
.prebuilt

# gcov run data, written by executing an instrumented binary
*.gcda

# gcov notes, written at instrumented compile time
*.gcno

# gcov annotated source, written by `gcov`
*.gcov
*.o
*.a

# `make dist` now writes to build/dist/, but older runs left one in the
# source root; ignore both spellings.
*.tar.gz
*.tgz
*.zip

# `make codegraph` regenerates this from src/ and tests/. It was committed
# once, so every `make codegraph` left the tree dirty. A dot-directory
# because it is build output, not prose for a reader.
.codegraph/
.worktrees/
.superpowers/

*.swp
*~
.DS_Store

# Python test imports
__pycache__/
*.pyc
*.pyo

# Reproducible benchmark inputs generated by tests/src/benchmark_icl.py
tests/generated/
